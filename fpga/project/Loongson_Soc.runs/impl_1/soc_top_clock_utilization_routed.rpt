# Location of BUFG Primitives 
set_property LOC BUFGCTRL_X0Y0 [get_cells s0_axi_rvalid_BUFG_inst]
set_property LOC BUFGCTRL_X0Y16 [get_cells pll_clk.u_clk_pll/inst/clkout2_buf]
set_property LOC BUFGCTRL_X0Y18 [get_cells pll_clk.u_clk_pll/inst/clkout1_buf]
